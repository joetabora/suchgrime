# Prisma Postgres (from Vercel Storage / Prisma Console)
# After connecting the DB on Vercel, run: vercel env pull .env
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
# Same as DATABASE_URL for CLI/migrations, or use the direct string from Prisma Console
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

ADMIN_PASSWORD="change-me"
AUTH_SECRET="generate-a-long-random-string"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
