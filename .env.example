# Neon / Postgres (Vercel + local against Neon)
# Prefer the pooled URL for the app, unpooled for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

ADMIN_PASSWORD="change-me"
AUTH_SECRET="generate-a-long-random-string"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe Dashboard → Developers → API keys / Webhooks
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
