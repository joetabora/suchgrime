# SQLite for local development (Prisma creates the file)
DATABASE_URL="file:./dev.db"

# For Vercel production, use Postgres (Neon, Vercel Postgres, etc.) and
# change prisma/schema.prisma datasource provider to "postgresql"

ADMIN_PASSWORD="change-me"
AUTH_SECRET="generate-a-long-random-string"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe Dashboard → Developers → API keys / Webhooks
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
