DATABASE_URL=postgresql://user:password@host/db?sslmode=require
NEXT_PUBLIC_SITE_URL=https://suchgrime.com

# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local

# CMS admin dashboard
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=change-me-to-a-strong-password
CMS_SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# SEO & discovery
GOOGLE_SITE_VERIFICATION=
INDEXNOW_KEY=suchgrime-indexnow-key

# Email notifications (Resend)
RESEND_API_KEY=
BOOKING_NOTIFY_EMAIL=hello@suchgrime.com
