<svg width="1200" height="800" viewBox="0 0 1200 800" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Dark laptop frame -->
  <rect x="100" y="50" width="1000" height="650" rx="20" fill="#1a1a1a"/>
  <rect x="120" y="70" width="960" height="600" fill="#000000"/>
  
  <!-- Screen content simulation -->
  <rect x="130" y="80" width="940" height="580" fill="#0a0a0a"/>
  
  <!-- Simplified GSC interface -->
  <text x="600" y="150" font-family="Arial" font-size="48" font-weight="bold" fill="#FFFFFF" text-anchor="middle">GUERRILLA</text>
  <text x="600" y="210" font-family="Arial" font-size="48" font-weight="bold" fill="#FFFFFF" text-anchor="middle">SOCIAL CLUB</text>
  
  <rect x="200" y="280" width="800" height="60" rx="30" fill="#FFFFFF"/>
  <text x="600" y="318" font-family="Arial" font-size="24" fill="#000000" text-anchor="middle">AI-Powered Community Platform</text>
  
  <!-- Feature boxes -->
  <rect x="200" y="380" width="250" height="200" fill="#1a1a1a"/>
  <rect x="475" y="380" width="250" height="200" fill="#1a1a1a"/>
  <rect x="750" y="380" width="250" height="200" fill="#1a1a1a"/>
  
  <!-- Laptop base -->
  <path d="M 50 700 L 1150 700 L 1100 750 L 100 750 Z" fill="#2a2a2a"/>
  
  <!-- Grunge texture overlay -->
  <rect x="0" y="0" width="1200" height="800" fill="url(#grunge)" opacity="0.1"/>
  
  <defs>
    <pattern id="grunge" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
      <circle cx="10" cy="10" r="2" fill="#000000" opacity="0.3"/>
      <circle cx="40" cy="30" r="1.5" fill="#000000" opacity="0.2"/>
      <circle cx="70" cy="50" r="2.5" fill="#000000" opacity="0.25"/>
      <circle cx="20" cy="70" r="1" fill="#000000" opacity="0.15"/>
      <circle cx="90" cy="85" r="2" fill="#000000" opacity="0.2"/>
    </pattern>
  </defs>
</svg>

