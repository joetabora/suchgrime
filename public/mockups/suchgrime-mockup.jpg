<svg width="1200" height="800" viewBox="0 0 1200 800" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Multiple devices mockup -->
  <!-- Laptop in background -->
  <rect x="50" y="150" width="900" height="600" rx="15" fill="#1a1a1a"/>
  <rect x="70" y="170" width="860" height="540" fill="#FFFFFF"/>
  
  <!-- SuchGrime content on laptop -->
  <rect x="80" y="180" width="840" height="520" fill="#FAFAFA"/>
  <text x="500" y="280" font-family="Arial" font-size="56" font-weight="bold" fill="#000000" text-anchor="middle">SuchGrime</text>
  <text x="500" y="340" font-family="Arial" font-size="20" fill="#666666" text-anchor="middle">Milwaukee Web Design & SEO</text>
  
  <rect x="200" y="380" width="180" height="60" rx="0" fill="#000000"/>
  <text x="290" y="415" font-family="Arial" font-size="16" font-weight="bold" fill="#FFFFFF" text-anchor="middle">Get Free Audit</text>
  
  <rect x="420" y="380" width="180" height="60" rx="0" fill="transparent" stroke="#000000" stroke-width="2"/>
  <text x="510" y="415" font-family="Arial" font-size="16" font-weight="bold" fill="#000000" text-anchor="middle">View Our Work</text>
  
  <!-- Phone in foreground -->
  <rect x="800" y="250" width="300" height="500" rx="30" fill="#0a0a0a"/>
  <rect x="820" y="280" width="260" height="440" fill="#FFFFFF"/>
  
  <!-- Phone content -->
  <text x="950" y="350" font-family="Arial" font-size="28" font-weight="bold" fill="#000000" text-anchor="middle">SuchGrime</text>
  <text x="950" y="390" font-family="Arial" font-size="12" fill="#666666" text-anchor="middle">Milwaukee-Built</text>
  <rect x="850" y="420" width="200" height="30" fill="#000000"/>
  
  <!-- Grunge overlay -->
  <rect x="0" y="0" width="1200" height="800" fill="url(#grunge)" opacity="0.08"/>
  
  <defs>
    <pattern id="grunge" x="0" y="0" width="80" height="80" patternUnits="userSpaceOnUse">
      <circle cx="15" cy="15" r="2" fill="#000000" opacity="0.4"/>
      <circle cx="45" cy="35" r="1.5" fill="#000000" opacity="0.3"/>
      <circle cx="65" cy="55" r="2" fill="#000000" opacity="0.35"/>
    </pattern>
  </defs>
</svg>

