<svg width="1200" height="800" viewBox="0 0 1200 800" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Dark laptop frame -->
  <rect x="100" y="50" width="1000" height="650" rx="20" fill="#0a0a0a"/>
  <rect x="120" y="70" width="960" height="600" fill="#000000"/>
  
  <!-- Dark screen -->
  <rect x="130" y="80" width="940" height="580" fill="#050505"/>
  
  <!-- Coming Soon text -->
  <text x="600" y="350" font-family="Arial" font-size="80" font-weight="bold" fill="#FFFFFF" text-anchor="middle">COMING SOON</text>
  <text x="600" y="420" font-family="Arial" font-size="32" fill="#999999" text-anchor="middle">Milwaukee Client Project</text>
  
  <!-- Progress indicator -->
  <rect x="400" y="480" width="400" height="4" fill="#1a1a1a"/>
  <rect x="400" y="480" width="280" height="4" fill="#FFFFFF"/>
  
  <text x="600" y="530" font-family="Arial" font-size="20" fill="#666666" text-anchor="middle">Website Refresh + Local SEO</text>
  
  <!-- Laptop base -->
  <path d="M 50 700 L 1150 700 L 1100 750 L 100 750 Z" fill="#1a1a1a"/>
  
  <!-- Heavy grunge texture -->
  <rect x="0" y="0" width="1200" height="800" fill="url(#heavyGrunge)" opacity="0.15"/>
  
  <defs>
    <pattern id="heavyGrunge" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
      <circle cx="10" cy="10" r="3" fill="#FFFFFF" opacity="0.2"/>
      <circle cx="40" cy="30" r="2" fill="#FFFFFF" opacity="0.15"/>
      <circle cx="70" cy="50" r="3.5" fill="#FFFFFF" opacity="0.25"/>
      <circle cx="20" cy="70" r="1.5" fill="#FFFFFF" opacity="0.1"/>
      <circle cx="90" cy="85" r="2.5" fill="#FFFFFF" opacity="0.2"/>
      <rect x="30" y="10" width="2" height="15" fill="#FFFFFF" opacity="0.1"/>
      <rect x="60" y="40" width="3" height="20" fill="#FFFFFF" opacity="0.12"/>
    </pattern>
  </defs>
</svg>

